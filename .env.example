[TEMPLATE]
# Copy to .env and fill in. Get a key at https://dashboard.sarvam.ai/
SARVAM_API_KEY=your-sarvam-api-key-here

# --- Sarvam real-time / streaming STT ---------------------------------------
# SARVAM_STREAMING_ENDPOINT=realtime   # realtime (saaras:v3-realtime, true partials) | legacy (saaras:v3/v4)
# SARVAM_STREAMING_MODEL=saaras:v3-realtime   # realtime endpoint also accepts saaras:v4
# SARVAM_STREAM_TYPE=balanced          # fast | balanced | simulated
# SARVAM_STREAMING_MODE=transcribe     # transcribe | translate | verbatim | translit | codemix
# SARVAM_LANGUAGE_CODE=auto            # auto-detect; or e.g. en-IN, hi-IN, te-IN
# SARVAM_VAD_THRESHOLD=0.3
# SARVAM_SILENCE_DURATION_MS=500
# SARVAM_MIN_SPEECH_DURATION_MS=250

# --- LLM field extraction (form filling) -------------------------------------
# LLM_EXTRACTION_ENABLED=true
# LLM_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# LLM_API_KEY=                              # leave empty -> built-in regex fallback extraction
# LLM_MODEL=gpt-4o-mini
# LLM_DEBOUNCE_SECONDS=1.5                  # batch consecutive finals before calling the LLM
# LLM_FIELD_SCHEMA=Extract personal/contact details people give during the meeting: full_name, email, phone, company, city, request/action_item. Only return fields that were actually spoken.

# --- Storage ----------------------------------------------------------------
# MONGO_URI=                                # e.g. mongodb://127.0.0.1:27017 ; empty -> JSON files in data/sessions
# MONGO_DB=voicebot
# MONGO_COLLECTION=sessions

# --- Server / transport -----------------------------------------------------
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000
# AUDIO_WS_URL=                             # default ws://127.0.0.1:8000/ws/audio (auto from SERVER_*)

# --- Bot join behaviour (reused from the batch project) ---------------------
# AUTO_CLICK_JOIN=false        # false: bot opens the meet anonymously and waits in the room/lobby; you join it in.
# BOT_DISPLAY_NAME=            # guest name used only in AUTO_CLICK_JOIN mode
# EPHEMERAL_PROFILE=true       # true: fresh throwaway profile per run (bot is never signed into your account)
# CHROME_USER_DATA_DIR=        # set to a folder to persist a *dedicated* bot Google account
# CHROME_PROFILE_DIRECTORY=Default
# JOIN_WAIT_TIMEOUT=120
