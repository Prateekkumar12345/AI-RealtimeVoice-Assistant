# Voicebot configuration template.
#
# Copy to .env and fill in only the four blanks marked <-- FILL THIS IN.
#   copy .env.example .env
#
# Everything else is already set to a working default and is deliberately left
# UNCOMMENTED, so this file can be copied straight into .env without losing any
# behaviour. The inline comments explain each knob; delete a line only if you
# want to fall back to the built-in default in config.py.
#
# Never commit a filled-in .env. It is already in .gitignore. The four values
# below are the only secrets this project has.

# =============================================================================
# SECRETS - the only four lines you must fill in
# =============================================================================

# <-- FILL THIS IN. Get a key at https://dashboard.sarvam.ai/
SARVAM_API_KEY=

# <-- FILL THIS IN. Use a DEDICATED bot account, not a personal one.
# The bot types this into Google's sign-in form unattended.
# Must have 2FA switched off. No spaces, or wrap the value in quotes.
GOOGLE_EMAIL=prateekkumar8056@gmail.com
GOOGLE_PASSWORD=Prateek@123

# =============================================================================
# Sarvam real-time / streaming STT
# =============================================================================
# realtime = true partials (saaras:v3-realtime) | legacy = saaras:v3/v4
SARVAM_STREAMING_ENDPOINT=realtime
SARVAM_STREAMING_MODEL=saaras:v3-realtime
# fast | balanced | simulated
SARVAM_STREAM_TYPE=balanced
# transcribe | translate | verbatim | translit | codemix
SARVAM_STREAMING_MODE=transcribe
# auto-detect; or e.g. en-IN, hi-IN, te-IN
SARVAM_LANGUAGE_CODE=auto
SARVAM_VAD_THRESHOLD=0.3
SARVAM_SILENCE_DURATION_MS=800
SARVAM_MIN_SPEECH_DURATION_MS=250

# =============================================================================
# LLM field extraction (this is what fills an email address into a form field)
# =============================================================================
LLM_EXTRACTION_ENABLED=true

# Provider is Sarvam. It reuses your SARVAM_API_KEY against Sarvam's
# OpenAI-compatible endpoint, so there is no second key to obtain and nothing
# extra to pay for.
LLM_PROVIDER=sarvam
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_MODEL=sarvam-105b
# Leave empty on purpose. Empty means "reuse SARVAM_API_KEY" -- see the fallback
# at utils/llm_extractor.py. Do NOT point LLM_BASE_URL at another provider while
# this is empty: that would ship your Sarvam key to that provider's servers.
# Only set this if you deliberately want a different provider AND you also set
# LLM_PROVIDER and LLM_BASE_URL to match.
LLM_API_KEY=
# Batch consecutive finals before calling the LLM. Never call it per-partial.
LLM_DEBOUNCE_SECONDS=1.5
LLM_FIELD_SCHEMA=Extract personal/contact details people give during the meeting: full_name, email, phone, company, city, request/action_item. Only return fields that were actually spoken.

# =============================================================================
# Storage
# =============================================================================
# e.g. mongodb://127.0.0.1:27017 ; leave empty -> JSON files in data/sessions
MONGO_URI=
MONGO_DB=voicebot
MONGO_COLLECTION=sessions

# =============================================================================
# Server / transport
# =============================================================================
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Defaults to ws://<SERVER_HOST>:<SERVER_PORT>/ws/audio, derived automatically
AUDIO_WS_URL=

# =============================================================================
# Speaker labels ("who spoke?")
# =============================================================================
# Meet mixes everyone into one audio stream, so speaker numbers are worked out
# from each participant's voice activity. The bot stays one speech-to-text
# stream instead of one per person, so this costs nothing extra.
SPEAKER_ATTRIBUTION=true

# =============================================================================
# Automatic Google sign-in
# =============================================================================
# The bot signs itself in and never asks a human to click through a login form.
# Requires a DEDICATED Google account with 2FA OFF. Google can still refuse
# (CAPTCHA, "unusual traffic", insecure-browser block); when it does the run
# fails loudly with a screenshot in assets/join_diagnostics/ rather than hanging.
# There is no interactive fallback, by design.
#
# AUTO_LOGIN=false means never type the password - rely on the vault alone.
AUTO_LOGIN=true

# Where the reusable session is kept. Set to an empty value to disable the
# vault entirely and fall back to a throwaway profile every run.
#
# How it works: a throwaway profile is seeded from SESSION_VAULT_DIR (7 files,
# ~176 KB, no caches), Meet sees the bot as that account, and on the way out the
# fresh session is written back - so the password is used about once a year,
# when Google's auth cookies finally expire, not once per meeting. Deleting this
# folder, or signing out of Google, revokes the stored session without touching
# the GOOGLE_PASSWORD above.
SESSION_VAULT_DIR=bot_session

# How long to wait for Google's email/password inputs to appear (seconds).
LOGIN_FIELD_TIMEOUT=45
# How long to wait for Google to finish redirecting after submitting (seconds).
LOGIN_SETTLE_TIMEOUT=30
# Leave empty to auto-detect the installed Chrome major version. Set it only if
# undetected-chromedriver fetches the wrong driver after a Chrome update.
CHROME_VERSION_MAIN=

# =============================================================================
# Bot join behaviour
# =============================================================================
# true: bot types its name, mutes itself, and clicks Join by itself.
# false: bot opens the meet anonymously and waits in the room/lobby.
AUTO_CLICK_JOIN=true
# Guest name used only in AUTO_CLICK_JOIN mode
BOT_DISPLAY_NAME=AI Notetaker

# NOTE: EPHEMERAL_PROFILE and CHROME_USER_DATA_DIR below are LEGACY. When
# SESSION_VAULT_DIR is set (the default) the bot always uses a disposable
# throwaway profile and ignores both of these. They still apply if you blank out
# SESSION_VAULT_DIR above.
# true: fresh throwaway profile per run
EPHEMERAL_PROFILE=false
# persistent, dedicated bot account profile root; sign in manually first
CHROME_USER_DATA_DIR=chrome_profile
# profile inside CHROME_USER_DATA_DIR
CHROME_PROFILE_DIRECTORY=Default

# How long to wait for the host to admit the bot (seconds)
JOIN_WAIT_TIMEOUT=120
# How long Meet may take to show a usable page after the URL opens (seconds)
PREJOIN_LOAD_TIMEOUT=45
# How long to keep looking for 'Join now' / 'Ask to join' (seconds)
JOIN_BUTTON_TIMEOUT=30
# Reload Meet and retry the join this many times when Meet refuses
JOIN_ATTEMPTS=2
# Save a screenshot + Meet's page text to assets/join_diagnostics on every
# failed join. This is also where a refused sign-in lands.
CAPTURE_JOIN_DIAGNOSTICS=true
# true: refuse to join unless the profile is signed into Google. Turn this on
# once you only join invite-only / domain-restricted meetings, where an
# anonymous guest is always refused with "You can't join this video call".
REQUIRE_SIGNED_IN_PROFILE=false
# How long with zero remote audio before the UI warns "no audio detected"
NO_AUDIO_WARNING_SECONDS=20
