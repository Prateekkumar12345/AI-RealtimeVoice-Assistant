# Copy to .env and fill in. Get a key at https://dashboard.sarvam.ai/
SARVAM_API_KEY=sk_qfogwms9_UqzClo1MRhgfzoC1bUpjp6LA

# --- Sarvam real-time / streaming STT ---------------------------------------
# SARVAM_STREAMING_ENDPOINT=realtime   # realtime (saaras:v3-realtime, true partials) | legacy (saaras:v3/v4)
# SARVAM_STREAMING_MODEL=saaras:v3-realtime   # realtime endpoint also accepts saaras:v4
# SARVAM_STREAM_TYPE=balanced          # fast | balanced | simulated
# SARVAM_STREAMING_MODE=transcribe     # transcribe | translate | verbatim | translit | codemix
# SARVAM_LANGUAGE_CODE=auto            # auto-detect; or e.g. en-IN, hi-IN, te-IN
# SARVAM_VAD_THRESHOLD=0.3
# SARVAM_SILENCE_DURATION_MS=500
# SARVAM_MIN_SPEECH_DURATION_MS=250

# --- LLM field extraction (form filling) -------------------------------------
# LLM_EXTRACTION_ENABLED=true
# LLM_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# LLM_API_KEY=                              # leave empty -> built-in regex fallback extraction
# LLM_MODEL=gpt-4o-mini
# LLM_DEBOUNCE_SECONDS=1.5                  # batch consecutive finals before calling the LLM
# LLM_FIELD_SCHEMA=Extract personal/contact details people give during the meeting: full_name, email, phone, company, city, request/action_item. Only return fields that were actually spoken.

# --- Storage ----------------------------------------------------------------
# MONGO_URI=                                # e.g. mongodb://127.0.0.1:27017 ; empty -> JSON files in data/sessions
# MONGO_DB=voicebot
# MONGO_COLLECTION=sessions

# --- Server / transport -----------------------------------------------------
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000
# AUDIO_WS_URL=                             # default ws://127.0.0.1:8000/ws/audio (auto from SERVER_*)

# --- Bot join behaviour (reused from the batch project) ---------------------
# AUTO_CLICK_JOIN=true         # true (default): bot types its name, mutes itself, and clicks Join by itself.
#                               # false: bot opens the meet anonymously and waits in the room/lobby; you join it in.
# BOT_DISPLAY_NAME=AI Notetaker  # guest name used only in AUTO_CLICK_JOIN mode
# EPHEMERAL_PROFILE=true       # true: fresh throwaway profile per run
# CHROME_USER_DATA_DIR=chrome_profile  # persistent, dedicated bot account profile root; sign in manually first
# CHROME_PROFILE_DIRECTORY=Default     # profile inside CHROME_USER_DATA_DIR
# JOIN_WAIT_TIMEOUT=120        # how long to wait for the host to admit the bot
# PREJOIN_LOAD_TIMEOUT=45       # how long Meet may take to show a usable page after the URL opens
# JOIN_BUTTON_TIMEOUT=30        # how long to keep looking for 'Join now' / 'Ask to join'
# JOIN_ATTEMPTS=2               # reload Meet and retry the join this many times when Meet refuses
# CAPTURE_JOIN_DIAGNOSTICS=true # save a screenshot + Meet's page text to assets/join_diagnostics on every failed join
# REQUIRE_SIGNED_IN_PROFILE=false  # true: refuse to try the join unless the bot profile is signed into Google.
#                               # Turn this on once you only join invite-only / domain-restricted meetings,
#                               # where an anonymous guest is always refused with "You can't join this video call".
# NO_AUDIO_WARNING_SECONDS=20  # how long with zero remote audio before the UI warns "no audio detected"
